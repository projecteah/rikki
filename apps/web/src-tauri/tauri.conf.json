{
	"productName": "Rikki",
	"version": "0.3.0",
	"identifier": "li.rikki.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:3000",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Rikki",
				"width": 900,
				"height": 600
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
